# Banco: SQLite para começar; troque pela URL do Postgres quando usar o docker-compose
DATABASE_URL=sqlite:///./frotagest.db
# DATABASE_URL=postgresql+psycopg://frotagest:frotagest@localhost:5432/frotagest

# Gere uma chave nova com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173

# Limite usado para gerar alertas de excesso de velocidade
SPEED_LIMIT_KMH=80

# Intervalo do worker que consulta os rastreadores (segundos)
POLL_INTERVAL_SECONDS=60

# Fotos dos comprovantes de entrega
UPLOAD_DIR=./uploads

# Webservice da Sascar (SasIntegra). Troque pelo de homologação, se a Sascar fornecer um.
# SASCAR_URL=https://sasintegra.sascar.com.br/SasIntegra/SasIntegraWSService
